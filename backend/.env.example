APP_NAME=KnowFlow AI
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./knowflow.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_READ_CHUNK_SIZE=1048576
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# OpenAI API 或兼容 OpenAI 协议的统一配置
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 聊天模型和 Embedding 使用不同服务商时，分别填写下面两组配置。
# 留空时，程序会回退到上面的 OPENAI_API_KEY 和 OPENAI_BASE_URL。
CHAT_API_KEY=
CHAT_BASE_URL=
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL_NAME=text-embedding-3-small
MODEL_REQUEST_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=1

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=knowflow_chunks
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_TOP_K=3
# 先扩大候选集再去重，避免重复 Chunk 占满最终 Top-K。
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RETRIEVAL_DISTANCE_THRESHOLD=0.6
AGENT_TOOL_CONTEXT_CHARACTERS=10000
