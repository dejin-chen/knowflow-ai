APP_NAME=KnowFlow AI
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./knowflow.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_READ_CHUNK_SIZE=1048576
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# OpenAI API 或兼容 OpenAI 协议的统一配置
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 聊天模型和 Embedding 使用不同服务商时，分别填写下面两组配置。
# 留空时，程序会回退到上面的 OPENAI_API_KEY 和 OPENAI_BASE_URL。
CHAT_API_KEY=
CHAT_BASE_URL=
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL_NAME=text-embedding-3-small
MODEL_REQUEST_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=1

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=knowflow_chunks
# 当前示例兼容服务单批最多接收 25 条，切换供应商后可按其限制调整。
EMBEDDING_BATCH_SIZE=25
RETRIEVAL_TOP_K=3
# 先扩大候选集再去重，避免重复 Chunk 占满最终 Top-K。
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RETRIEVAL_DISTANCE_THRESHOLD=0.6
# 向量召回与 BM25 关键词召回并行执行，再通过 RRF 合并排名。
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_BM25_TOP_K=12
RETRIEVAL_BM25_MIN_SCORE=0.0
# 低分 BM25 结果可以参与排序，但不能单独绕过资料不足判断。
RETRIEVAL_BM25_EVIDENCE_THRESHOLD=8.0
RETRIEVAL_RRF_K=60
RETRIEVAL_RRF_VECTOR_WEIGHT=1.0
RETRIEVAL_RRF_BM25_WEIGHT=1.5
# 默认让聊天模型对扩大召回候选排序；失败时自动降级为本地词法排序。
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_STRATEGY=llm
# 留空时复用 CHAT_MODEL；可以单独配置更便宜、更快的兼容模型。
RETRIEVAL_RERANK_MODEL=
RETRIEVAL_RERANK_MAX_CANDIDATES=12
RETRIEVAL_RERANK_MAX_CHUNK_CHARACTERS=800
# 仅用于 lexical 策略或 LLM Rerank 失败后的降级排序。
RETRIEVAL_RERANK_LEXICAL_WEIGHT=0.5
RAG_ANSWER_CACHE_ENABLED=true
RAG_ANSWER_CACHE_TTL_SECONDS=3600
# Prompt 或检索策略发生不兼容变化时递增版本，旧缓存键会自然失效。
RAG_ANSWER_CACHE_VERSION=v1
# 防止 TTL 窗口内大量不同问题让 SQLite 缓存表无限增长。
RAG_ANSWER_CACHE_MAX_ENTRIES=2000
RAG_ANSWER_CACHE_MAX_ENTRIES_PER_KB=500
AGENT_TOOL_CONTEXT_CHARACTERS=10000
